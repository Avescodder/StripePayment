# ====================
# Django Configuration
# ====================

# SECURITY WARNING: Generate a new secret key for production!
# You can generate one using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Debug mode - MUST be False in production
DEBUG=False

# Allowed hosts - add your domain names
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Admin URL (change from default 'admin/' for security)
ADMIN_URL=secure-admin-panel/

# ====================
# Database Configuration
# ====================

POSTGRES_DB=stripe_production_db
POSTGRES_USER=stripe_user
POSTGRES_PASSWORD=your-strong-database-password-change-this
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ====================
# Redis Configuration
# ====================

REDIS_URL=redis://redis:6379/0

# ====================
# Stripe Configuration
# ====================

# IMPORTANT: Use LIVE keys in production!
# Get your keys from: https://dashboard.stripe.com/apikeys

# USD Account
STRIPE_PUBLISHABLE_KEY_USD=pk_live_your_publishable_key_usd
STRIPE_SECRET_KEY_USD=sk_live_your_secret_key_usd

# EUR Account
STRIPE_PUBLISHABLE_KEY_EUR=pk_live_your_publishable_key_eur
STRIPE_SECRET_KEY_EUR=sk_live_your_secret_key_eur

# Webhook Secret
# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ====================
# Monitoring & Logging
# ====================

# Sentry DSN (optional but recommended)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Django log level (INFO, WARNING, ERROR, DEBUG)
DJANGO_LOG_LEVEL=INFO

# ====================
# Backup & Security
# ====================

# Time zone
TZ=Europe/Moscow